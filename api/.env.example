# Required
FIREBASE_PROJECT_ID=          # same Firebase project as the web app; used to verify sign-in tokens
ALLOWED_ORIGINS=https://your-app.vercel.app   # comma-separated web origins allowed to call the API
DATA_DIR=/data                # persistent disk for the SQLite database
TOKEN_ENCRYPTION_KEY=         # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI receipt reading and agents (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Bank connections (Plaid dashboard). Leave empty to turn bank linking off.
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
PLAID_ENV=production
